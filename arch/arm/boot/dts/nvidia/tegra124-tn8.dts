// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/sound/rt5640.h>

/* tegra124 */
#include "tegra124.dtsi"
/* tn8 */
#include "tegra124-tn8-emc.dtsi"
#include "tegra124-tn8-pinmux.dtsi"

/ {
	model = "NVIDIA SHIELD Tablet";
	compatible = "nvidia,tn8", "nvidia,tegra124";
	chassis-type = "tablet";

	aliases {
		mmc0 = &sdmmc4; /* eMMC */
		mmc1 = &sdmmc1; /* WiFi */

		rtc0 = &palmas;
		rtc1 = "/rtc@0,7000e000";

		serial0 = &uartd; /* Console */
		serial1 = &uartc; /* Bluetooth */

		serial2 = &uarta;
		serial3 = &uartb;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "panic=5 loglevel=7 fbcon=rotate:3 gpt clk_ignore_unused root=/dev/mmcblk0p23 rw rootwait rootflags=defaults,noatime,nodiratime loop=media/0/Linux/archlinux.img loopflags=compress=zstd:3,commit=120,discard=async,noatime,nodiratime";
		/* NVIDIA moment. God why is the SHIELD bootloader like this ??? */
		linux,initrd-start = <0x81680000>;
		linux,initrd-end = <0x82800000>;
	};

	memory@80000000 {
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};

	/* Another NVIDIA SHIELD bootloader moment */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		bootloader_fb: bootloader-framebuffer@ad012000 {
			reg = <0x0 0xad012000 0x0 0x011e0000>;
			no-map;
		};

		framebuffer: framebuffer@f7c00000 {
			reg = <0x0 0xf7c00000 0x0 0x01200000>;
			no-map;
		};

		framebuffer2: framebuffer2@f8e00000 {
			reg = <0x0 0xf8e00000 0x0 0x04800000>;
			no-map;
		};

		nck: nck@fd700000 {
			reg = <0x0 0xfd700000 0x0 0x00100000>;
			no-map;
		};

		/* Downstream doesn't mention this area in its dmesg, but I was unable to remove it without causing a crash. */
		/* Oh well, it's 8.32 MB */
		would_be_freed_fd800000: would-be-freed@fd800000 {
			reg = <0x0 0xfd800000 0x0 0x007f0000>;
			no-map;
		};

		lp0: lp0@fdfff000 {
			reg = <0x0 0xfdfff000 0x0 0x00000820>;
			no-map;
		};

		tsec: tsec@fe000000 {
			reg = <0x0 0xfe000000 0x0 0x02000000>;
			no-map;
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight"; // CONFIG_BACKLIGHT_PWM
		pwms = <&pwm 1 40000>;

		brightness-levels = <0 4 8 16 32 64 128 255>;
		default-brightness-level = <6>;

		power-supply = <&en_lcd_bl>;
		enable-gpios = <&gpio TEGRA_GPIO(H, 1) GPIO_ACTIVE_HIGH>;
	};

	// UNFINISHED
	host1x@50000000 {
		dsi@54300000 {
			status = "okay";

			avdd-dsi-csi-supply = <&ldo5_reg>;

			panel@0 {
				compatible = "auo,b080uan01"; // CONFIG_DRM_PANEL_SIMPLE
				reg = <0>;

				//avdd-supply = <&avdd_lcd>;
				power-supply = <&vddio_dvdd_lcd>;

				backlight = <&backlight>;
			};
		};
	};

	gpu@57000000 {
		status = "okay";
		vdd-supply = <&vdd_gpu>;
	};

	// UNKNOWN
	uarta: serial@70006000 {
		status = "okay";
		compatible = "nvidia,tegra124-hsuart"; // CONFIG_SERIAL_TEGRA
	};

	// UNKNOWN
	uartb: serial@70006040 {
		status = "okay";
		compatible = "nvidia,tegra124-hsuart"; // CONFIG_SERIAL_TEGRA
	};

	/* Bluetooth */
	uartc: serial@70006200 {
		compatible = "nvidia,tegra124-hsuart", "nvidia,tegra30-hsuart"; // CONFIG_SERIAL_TEGRA
		reset-names = "serial";
		/delete-property/ reg-shift;
		status = "okay";

		nvidia,adjust-baud-rates = <0 9600 100>,
					   <9600 115200 200>,
					   <1000000 4000000 136>;

		/*
			Will only function from a restart from downstream kernel for now.
			
			Note :
			- Copy /system/etc/firmware/bcm43241.hcd into /lib/firmware/brcm/BCM4334B0.nvidia,tn8.hcd in initramfs.
		*/
		bluetooth {
			compatible = "brcm,bcm43241b0-bt", "brcm,bcm4334-bt"; // CONFIG_BT_HCIUART_BCM
			max-speed = <4000000>;

			clocks = <&tegra_pmc TEGRA_PMC_CLK_BLINK>;
			clock-names = "txco";

			interrupt-parent = <&gpio>;
			interrupts = <TEGRA_GPIO(U, 6) IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "host-wakeup";

			device-wakeup-gpios = <&gpio TEGRA_GPIO(EE, 1) GPIO_ACTIVE_HIGH>;
			shutdown-gpios = <&gpio TEGRA_GPIO(R, 1) GPIO_ACTIVE_HIGH>;
			reset-gpios = <&gpio TEGRA_GPIO(X, 1) GPIO_ACTIVE_HIGH>;

			vbat-supply = <&palmas_smps9_reg>;
			vddio-supply = <&palmas_smps8_reg>;
		};
	};

	// Console
	uartd: serial@70006300 {
		status = "okay";
		compatible = "nvidia,tegra124-uart"; // CONFIG_SERIAL_8250_TEGRA
	};

	pwm@7000a000 {
		status = "okay";
	};

	i2c@7000c000 {
		status = "okay";
		clock-frequency = <400000>;

		// Couldn't get that to work with cm3232 or cm32181
		light@10 {
			compatible = "capella,cm3217";
			reg = <0x10>;
			vdd-supply = <&palmas_smps9_reg>;
		};

		imu@69 {
			compatible = "invensense,mpu6515"; // CONFIG_INV_MPU6050_I2C
			reg = <0x69>;

			interrupt-parent = <&gpio>;
			interrupts = <TEGRA_GPIO(S, 0) IRQ_TYPE_EDGE_RISING>;

			vdd-supply   = <&palmas_smps9_reg>;
			vddio-supply = <&palmas_smps8_reg>;
			mount-matrix = "-1", "0",  "0",
						"0",  "1",  "0",
						"0",  "0", "-1";

			i2c-gate {
				#address-cells = <1>;
				#size-cells = <0>;

				magnetometer@d {
					compatible = "asahi-kasei,ak8963"; // CONFIG_AK8975
					reg = <0x0d>;

					vid-supply = <&palmas_smps8_reg>;
					vdd-supply = <&palmas_smps9_reg>;

					mount-matrix = "-1", "0",  "0",
								"0",  "1",  "0",
								"0",  "0", "-1";
				};
			};
		};

		rt5639: audio-codec@1c {
			compatible = "realtek,rt5639"; // CONFIG_SND_SOC_TEGRA_RT5640
			reg = <0x1c>;

			interrupt-parent = <&gpio>;
			interrupts = <TEGRA_GPIO(H, 4) IRQ_TYPE_EDGE_FALLING>;

			realtek,dmic1-data-pin = <RT5640_DMIC1_DATA_PIN_IN1P>;
			realtek,ldo1-en-gpios = <&gpio TEGRA_GPIO(R, 2) GPIO_ACTIVE_HIGH>;
			realtek,jack-detect-source = <RT5640_JD_SRC_HDA_HEADER>;
		};
	};

	// UNFINISHED
	i2c@7000c400 {
		status = "okay";
		clock-frequency = <100000>;

		// max17048@36 mentioned in downstream DTS but disabled.

		fuel_gauge: fuel-gauge@0b {
			compatible = "onsemi,lc709203f"; // CONFIG_FUEL_GAUGE_LC709203F
			reg = <0x0b>;

			interrupt-parent = <&gpio>;
			interrupts = <TEGRA_GPIO(Q, 5) IRQ_TYPE_NONE>;

			// Add monitored-battery ?
			power-supplies = <&charger>;

			onsemi,thermistor-beta = <3435>;
			onsemi,alert-low-rsoc = <0>;
			onsemi,alert-low-voltage = <0>;
		};

		charger: charger@6b {
			compatible = "ti,bq24193", "ti,bq24192"; // CONFIG_CHARGER_BQ24190
			reg = <0x6b>;

			interrupt-parent = <&gpio>;
			interrupts = <TEGRA_GPIO(J, 0) GPIO_ACTIVE_LOW>;

			omit-battery-class;
			// Add monitored-battery ?

			battery_charger: charger {
				regulator-name = "batt_regulator";
			};

			usb0_vbus: usb-otg-vbus {
				regulator-name = "vbus_regulator";
			};
		};

		power-monitor@40 {
			compatible = "ti,ina3221"; // CONFIG_SENSORS_INA3221
			reg = <0x40>;
			#address-cells = <1>;
			#size-cells = <0>;

			channel@0 {
				reg = <0x0>;
				label = "VDD_BAT";
				shunt-resistor-micro-ohms = <1000>;
			};

			channel@1 {
				reg = <0x1>;
				label = "VDD_USB_5V0";
				shunt-resistor-micro-ohms = <10000>;
			};

			channel@2 {
				reg = <0x2>;
				label = "VDD_SYS_MDM";
				shunt-resistor-micro-ohms = <1000>;
			};
		};
	};

	i2c@7000c500 {
		status = "okay";
		clock-frequency = <400000>;
	};

	i2c@7000c700 {
		status = "okay";
		clock-frequency = <100000>;
	};

	i2c@7000d000 {
		status = "okay";
		clock-frequency = <400000>;

		palmas: pmic@58 {
			compatible = "ti,tps65913", "ti,palmas"; // CONFIG_PINCTRL_PALMAS
			reg = <0x58>;
			interrupts = <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>;

			#interrupt-cells = <2>;
			interrupt-controller;

			ti,system-power-controller;

			palmas_gpadc: adc {
				compatible = "ti,palmas-gpadc"; // CONFIG_PALMAS_GPADC
				interrupts = <18 IRQ_TYPE_NONE
						  16 IRQ_TYPE_NONE
						  17 IRQ_TYPE_NONE>;

				ti,channel0-current-microamp = <5>;
				ti,channel3-current-microamp = <400>;
				ti,enable-extended-delay;

				#io-channel-cells = <1>;
			};

			palmas_extcon: extcon {
				compatible = "ti,palmas-usb-vid"; // CONFIG_EXTCON_PALMAS

				ti,enable-vbus-detection;
				ti,enable-id-detection;

				ti,wakeup;
			};

			palmas_gpio: gpio {
				compatible = "ti,palmas-gpio"; // CONFIG_GPIO_PALMAS
				gpio-controller;
				#gpio-cells = <2>;
			};

			clk32kg_pmic: palmas-clk32k@0 {
				compatible = "ti,palmas-clk32kg"; // CONFIG_COMMON_CLK_PALMAS
				#clock-cells = <0>;
			};

			palmas_clk32k@1 {
				compatible = "ti,palmas-clk32kgaudio"; // CONFIG_COMMON_CLK_PALMAS
				#clock-cells = <0>;
			};

			pinmux {
				compatible = "ti,tps65913-pinctrl"; // CONFIG_PINCTRL_PALMAS

				pinctrl-names = "default";
				pinctrl-0 = <&palmas_default>;

				palmas_default: pinmux {
					powergood {
						pins = "powergood";
						function = "powergood";
					};

					vac {
						pins = "vac";
						function = "vac";
					};

					pin_gpio0 {
						pins = "gpio0";
						function = "id";
						bias-pull-up;
					};

					pin_gpio1 {
						pins = "gpio1";
						function = "gpio";
						bias-disable;
					};

					pin_gpio6 {
						pins = "gpio2", "gpio3", "gpio4", "gpio6", "gpio7";
						function = "gpio";
					};

					pin_gpio5 {
						pins = "gpio5";
						function = "clk32kgaudio";
					};
				};
			};

			pmic {
				compatible = "ti,tps65913-pmic", "ti,palmas-pmic"; // CONFIG_REGULATOR_PALMAS
				ldo1-in-supply = <&palmas_smps6_reg>;
				ldo5-in-supply = <&palmas_smps8_reg>;
				ldo9-in-supply = <&palmas_smps9_reg>;
				ldoln-in-supply = <&palmas_smps10_out2_reg>;
				ldousb-in-supply = <&palmas_smps10_out2_reg>;

				regulators {
					/* CPU core voltage (SMPS123, 0.65–1.4V) */
					vdd_cpu: smps123 {
						regulator-name = "vdd-cpu";
						regulator-min-microvolt = <650000>;
						regulator-max-microvolt = <1400000>;
						regulator-always-on;
						regulator-boot-on;
					};

					/* GPU core voltage (SMPS45, 0.7–1.4V) */
					vdd_gpu: smps45 {
						regulator-name = "vdd-gpu";
						regulator-min-microvolt = <700000>;
						regulator-max-microvolt = <1400000>;
						regulator-init-microvolt = <1000000>;
						regulator-always-on; // --- Could be necessary
						//regulator-boot-on;
					};

					/* DDR voltage (SMPS6, fixed 1.35V) */
					palmas_smps6_reg: smps6 {
						regulator-name = "vddio-ddr";
						// regulator-min-microvolt = <1350000>;
						// regulator-max-microvolt = <1350000>;
						regulator-always-on;
						regulator-boot-on;
					};

					/* SoC core voltage (SMPS7, 0.7–1.4V) */
					vdd_core: smps7 {
						regulator-name = "vdd-core";
						regulator-min-microvolt = <700000>;
						regulator-max-microvolt = <1400000>;
						regulator-always-on;
						regulator-boot-on;
					};

					/* 1.8V I/O rail (SMPS8) */
					palmas_smps8_reg: smps8 {
						regulator-name = "vdd-1v8";
						//regulator-min-microvolt = <1800000>;
						//regulator-max-microvolt = <1800000>;
						regulator-always-on;
						regulator-boot-on;
					};

					/* 3.3V sensor / SDMMC3 rail (SMPS9) */
					palmas_smps9_reg: smps9 {
						regulator-name = "vdd-snsr";
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-always-on;
						regulator-boot-on;
					};

					/* 5V output 1 (SMPS10_OUT1) */
					palmas_smps10_out1_reg: smps10_out1 {
						regulator-name = "vdd-out1-5v0";
						regulator-min-microvolt = <5000000>;
						regulator-max-microvolt = <5000000>;
					};

					/* 5V output 2 (SMPS10_OUT2) */
					palmas_smps10_out2_reg: smps10_out2 {
						regulator-name = "vdd-out2-5v0";
						regulator-min-microvolt = <5000000>;
						regulator-max-microvolt = <5000000>;
					};

					/* PLL supply (LDO1, 1.05V) */
					ldo1 {
						regulator-name = "avdd-pll";
						//regulator-min-microvolt = <1050000>;
						//regulator-max-microvolt = <1050000>;
						regulator-always-on;
						regulator-boot-on;
					};

					/* LCD AVDD / touch analogue (LDO2, 3.3V) */
					avdd_lcd: ldo2 {
						regulator-name = "avdd-lcd";
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-boot-on;
						regulator-always-on; // TEMPORARY
					};

					/* Touch supply (LDO3, 3.0V) */
					ldo3_reg: ldo3 {
						regulator-name = "vdd-touch";
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
						regulator-enable-ramp-delay = <3000>;
						ti,disable-pull-down;
					};

					/* Camera AVDD (LDO4, 2.7V) */
					ldo4 {
						regulator-name = "avdd-cam1";
						regulator-min-microvolt = <2700000>;
						regulator-max-microvolt = <2700000>;
					};

					/* DSI/CSI supply (LDO5, 1.2V) */
					ldo5_reg: ldo5 {
						regulator-name = "avdd-dsi-csi";
						//regulator-min-microvolt = <1200000>;
						//regulator-max-microvolt = <1200000>;
						regulator-always-on; // TEMPORARY
						regulator-boot-on; // TEMPORARY
					};

					/* Fuse blow (LDO6, 1.8V) */
					ldo6 {
						regulator-name = "vpp-fuse";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <1800000>;
					};

					/* Camera AF VCM (LDO7, 2.7V) */
					ldo7 {
						regulator-name = "avdd-cam-af";
						regulator-min-microvolt = <2700000>;
						regulator-max-microvolt = <2700000>;
					};

					/* RTC supply (LDO8, 0.95V) */
					ldo8 {
						regulator-name = "vdd-rtc";
						regulator-min-microvolt = <950000>;
						regulator-max-microvolt = <950000>;
						regulator-always-on;
						regulator-boot-on;
						ti,enable-ldo8-tracking;
					};

					/* LDO9: variable 1.8/3.3 V for microSD I/O */
					ldo9 {
						regulator-name = "vddio-sdmmc-2";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <3300000>;
					};

					/* LDOLN – HDMI / HV I/O supply */
					ldoln_reg: ldoln {
						regulator-name = "vddio-hv";
						// regulator-min-microvolt = <3300000>;
						// regulator-max-microvolt = <3300000>;
						regulator-always-on;
						regulator-boot-on;
					};

					/* LDOUSB – USB PHY AVDD 3.3 V */
					ldousb_reg: ldousb {
						regulator-name = "avdd-usb";
						// regulator-min-microvolt = <3300000>;
						// regulator-max-microvolt = <3300000>;
						regulator-always-on;
						regulator-boot-on;
					};
				};
			};

			rtc {
				compatible = "ti,palmas-rtc"; // CONFIG_RTC_DRV_PALMAS
				interrupt-parent = <&palmas>;
				interrupts = <8 0>;
			};
		};
	};

	i2c@7000d100 {
		status = "okay";
		clock-frequency = <400000>;
	};

	pmc@7000e400 {
		// nvidia,invert-interrupt; --- Downstream uses it, but mainline gets crashed ?

		/* --- VERIFY THE VALUES --- */
		nvidia,suspend-mode = <1>;
		nvidia,cpu-pwr-good-time = <500>;
		nvidia,cpu-pwr-off-time = <300>;
		nvidia,core-pwr-good-time = <3845 3845>;
		nvidia,core-pwr-off-time = <2000>;
		nvidia,core-power-req-active-high;
		nvidia,sys-clock-req-active-high;
		core-supply = <&vdd_core>;

		/* Clear DEV_ON bit in DEV_CTRL register of TPS65913 PMIC  */
		i2c-thermtrip {
			nvidia,i2c-controller-id = <4>;
			nvidia,bus-addr = <0x58>;
			nvidia,reg-addr = <0xA0>;
			nvidia,reg-data = <0x00>;
		};
	};

	brcm_wifi_pwrseq: pwrseq-wifi {
		compatible = "mmc-pwrseq-simple"; // CONFIG_PWRSEQ_SIMPLE

		clocks = <&tegra_pmc TEGRA_PMC_CLK_BLINK>;
		clock-names = "ext_clock";

		reset-gpios = <&gpio TEGRA_GPIO(X, 7) GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <300>;
		power-off-delay-us = <300>;
	};

	/* Wi-Fi */
	sdmmc1: mmc@700b0000 {
		status = "okay";

		#address-cells = <1>;
		#size-cells = <0>;

		keep-power-in-suspend;
		bus-width = <4>;
		non-removable;

		mmc-pwrseq = <&brcm_wifi_pwrseq>;
		vmmc-supply = <&palmas_smps9_reg>;
		vqmmc-supply = <&palmas_smps8_reg>;

		/*
			Will only function from a restart from downstream kernel for now.
			
			Note :
			- Copy `/system/vendor/firmware/bcm43241/fw_bcmdhd.bin` into `/lib/firmware/brcm/brcmfmac43241b0-sdio.nvidia,tn8.bin` in initramfs.
			- Copy `/data/misc/wifi/firmware/nvram.txt` into `/lib/firmware/brcm/brcmfmac43241b0-sdio.txt` in initramfs.
			- clm_blob currently missing. Optional.
		*/
		wifi@1 {
			compatible = "brcm,bcm43241b0-fmac", "brcm,bcm4329-fmac"; // CONFIG_BRCMFMAC_SDIO
			reg = <1>;

			interrupt-parent = <&gpio>;
			interrupts = <TEGRA_GPIO(U, 5) IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "host-wake";
		};
	};

	/* eMMC */
	sdmmc4: mmc@700b0600 {
		status = "okay";
		bus-width = <8>;
		non-removable;
	};

	/* CPU DFLL clock */
	clock@70110000 {
		status = "okay";
		nvidia,i2c-fs-rate = <400000>;
		vdd-cpu-supply = <&vdd_cpu>;
	};
	
	/* Audio Hub */
	ahub@70300000 {
		i2s@70301100 {
			status = "okay";
		};
	};

	clk32k_in: clock-32k {
		compatible = "fixed-clock"; // CONFIG_COMMON_CLK
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "ref-oscillator";
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_suspend = <0x84000001>;
		cpu_on = <0x84000003>;
	};

	/*
	 * A `psci` node is present in this file even though PSCI is NOT used to
	 * power on CPU1-3 - on this board's (Android L) bootloader, PSCI CPU_ON
	 * claims success but never actually powers them on. Do not remove the
	 * psci node thinking it's unused: the kernel still needs it for one
	 * thing - registering its reset vector with firmware, via a CPU_ON call
	 * targeting CPU0 (already running) rather than the CPUs actually being
	 * booted. Actual CPU1-3 bring-up happens directly via PMC instead.
	 */
	cpus {
		cpu0: cpu@0 {
			vdd-cpu-supply = <&vdd_cpu>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@1 {
			#cooling-cells = <2>;
		};

		cpu2: cpu@2 {
			#cooling-cells = <2>;
		};

		cpu3: cpu@3 {
			#cooling-cells = <2>;
		};
	};

	extcon-keys {
		compatible = "gpio-keys"; // CONFIG_KEYBOARD_GPIO
		
		sw-lid {
			label = "Lid Switch";
			gpios = <&gpio TEGRA_GPIO(R, 4) GPIO_ACTIVE_LOW>;
			linux,code = <SW_LID>;
			linux,input-type = <EV_SW>;
			wakeup-source;
			debounce-interval = <300>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys"; // CONFIG_KEYBOARD_GPIO

		key-power {
			label = "Power";
			gpios = <&gpio TEGRA_GPIO(Q, 0) GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			debounce-interval = <10>;
			wakeup-source;
		};

		key-volume-down {
			label = "Volume Down";
			gpios = <&gpio TEGRA_GPIO(Q, 7) GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
			debounce-interval = <10>;
		};

		key-volume-up {
			label = "Volume Up";
			gpios = <&gpio TEGRA_GPIO(Q, 6) GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <10>;
		};
	};

	hda@70030000 {
		status = "okay";
	};

	vdd_ac_bat_reg: regulator-acbat {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "vdd_ac_bat";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
	en_lcd_bl: regulator-lcden {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "en-lcd-bl";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		gpio = <&gpio TEGRA_GPIO(H, 2) GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
	vddio_sd: regulator-sdmmc3 {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "vddio_sd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio TEGRA_GPIO(R, 0) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&palmas_smps9_reg>;
	};
	vddio_dvdd_lcd: regulator-lcd {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "vddio_dvdd_lcd";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&palmas_gpio 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&palmas_smps8_reg>;
	};
	vdd_cam_af: regulator-cam {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "vdd_cam_af";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&palmas_gpio 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&palmas_smps8_reg>;
	};
	vdd_hdmi_n5: regulator-hdmi {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "vdd-hdmi-n5";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		enable-active-high;
		gpio = <&gpio TEGRA_GPIO(N, 5) GPIO_ACTIVE_HIGH>;
		vin-supply = <&palmas_smps6_reg>;
	};
	vdd_hdmi_5v0: regulator-hdmicon {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "vdd_hdmi_5v0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio TEGRA_GPIO(K, 6) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&palmas_smps10_out1_reg>;
	};
	vdd_ts_1v8: regulator-ts-1v8 {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "vdd_ts_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio TEGRA_GPIO(K, 1) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&palmas_smps8_reg>;
	};
	avdd_ts_3v3: regulator-ts-3v3 {
		compatible = "regulator-fixed"; // CONFIG_REGULATOR_FIXED_VOLTAGE
		regulator-name = "avdd_ts_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&palmas_gpio 2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		vin-supply = <&ldo3_reg>;
	};

	sound {
		compatible = "nvidia,tegra-audio-rt5640-tn8", "nvidia,tegra-audio-rt5640"; // CONFIG_SND_SOC_TEGRA_RT5640
		nvidia,model = "NVIDIA SHIELD Tablet RT5639";

		nvidia,audio-routing =
			"Headphones", "HPOR",
			"Headphones", "HPOL",
			"Speakers", "SPORP",
			"Speakers", "SPORN",
			"Speakers", "SPOLP",
			"Speakers", "SPOLN",
			"Mic Jack", "MICBIAS1",
			"DMIC L1", "Int Mic",
			"DMIC L2", "Int Mic",
			"DMIC R1", "Int Mic",
			"DMIC R2", "Int Mic",
			"IN2P", "Mic Jack",
			"IN2N", "Mic Jack";

		nvidia,i2s-controller = <&tegra_i2s1>;
		nvidia,audio-codec = <&rt5639>;

		clocks = <&tegra_car TEGRA124_CLK_PLL_A>, <&tegra_car TEGRA124_CLK_PLL_A_OUT0>, <&tegra_pmc TEGRA_PMC_CLK_OUT_1>;
		clock-names = "pll_a", "pll_a_out0", "mclk";

		assigned-clocks = <&tegra_car TEGRA124_CLK_EXTERN1>, <&tegra_pmc TEGRA_PMC_CLK_OUT_1>;
		assigned-clock-parents = <&tegra_car TEGRA124_CLK_PLL_A_OUT0>, <&tegra_car TEGRA124_CLK_EXTERN1>;
	};

	// ---------------------------------- THERMAL ----------------------------------

	/*
	 * Downstream has Tdiode (which we can't implement) and Battery... which gets
	 * replaced by the fuel gauge's sensor in the final DTS.
	 */

	/* Note : downstream uses this one *essentially* as the skin sensor I believe... */
	tboard_thermistor: thermal-sensor-board {
		compatible = "generic-adc-thermal"; // CONFIG_GENERIC_ADC_THERMAL
		#thermal-sensor-cells = <0>;

		io-channels = <&palmas_gpadc 1>;
		io-channel-names = "sensor-channel";

		temperature-lookup-table = <
			 (-40000)  2578   (-39000)  2577   (-38000)  2576   (-37000)  2575
			 (-36000)  2574   (-35000)  2573   (-34000)  2572   (-33000)  2571
			 (-32000)  2569   (-31000)  2568   (-30000)  2567   (-29000)  2565
			 (-28000)  2563   (-27000)  2561   (-26000)  2559   (-25000)  2557
			 (-24000)  2555   (-23000)  2553   (-22000)  2550   (-21000)  2548
			 (-20000)  2545   (-19000)  2542   (-18000)  2539   (-17000)  2536
			 (-16000)  2532   (-15000)  2529   (-14000)  2525   (-13000)  2521
			 (-12000)  2517   (-11000)  2512   (-10000)  2507    (-9000)  2502
			  (-8000)  2497    (-7000)  2492    (-6000)  2486    (-5000)  2480
			  (-4000)  2473    (-3000)  2467    (-2000)  2460    (-1000)  2452
			        0  2445       1000  2437       2000  2428       3000  2419
			     4000  2410       5000  2401       6000  2391       7000  2380
			     8000  2369       9000  2358      10000  2346      11000  2334
			    12000  2322      13000  2308      14000  2295      15000  2281
			    16000  2266      17000  2251      18000  2236      19000  2219
			    20000  2203      21000  2186      22000  2168      23000  2150
			    24000  2131      25000  2112      26000  2092      27000  2072
			    28000  2052      29000  2030      30000  2009      31000  1987
			    32000  1964      33000  1941      34000  1918      35000  1894
			    36000  1870      37000  1845      38000  1820      39000  1795
			    40000  1769      41000  1743      42000  1717      43000  1691
			    44000  1664      45000  1637      46000  1610      47000  1583
			    48000  1555      49000  1528      50000  1500      51000  1472
			    52000  1445      53000  1417      54000  1390      55000  1362
			    56000  1334      57000  1307      58000  1280      59000  1253
			    60000  1226      61000  1199      62000  1172      63000  1146
			    64000  1120      65000  1094      66000  1069      67000  1044
			    68000  1019      69000   994      70000   970      71000   946
			    72000   922      73000   899      74000   877      75000   854
			    76000   832      77000   811      78000   789      79000   769
			    80000   748      81000   729      82000   709      83000   690
			    84000   671      85000   653      86000   635      87000   618
			    88000   601      89000   584      90000   568      91000   552
			    92000   537      93000   522      94000   507      95000   493
			    96000   479      97000   465      98000   452      99000   439
			   100000   427     101000   415     102000   403     103000   391
			   104000   380     105000   369     106000   359     107000   349
			   108000   339     109000   329     110000   320     111000   310
			   112000   302     113000   293     114000   285     115000   277
			   116000   269     117000   261     118000   254     119000   247
			   120000   240     121000   233     122000   226     123000   220
			   124000   214     125000   208
		>;
	};

	/* Thus, I copied the mocha's values. */
	thermal-zones {
		board-thermal {
			polling-delay-passive = <1000>; /* milliseconds */
			polling-delay = <10000>; /* milliseconds */

			thermal-sensors = <&tboard_thermistor>;

			trips {
				board_alert_trip: board-alert {
					/* throttle at 50C until temperature drops to 49.5C */
					temperature = <50000>; // downstream uses 40000
					hysteresis = <500>; // and 1000
					type = "passive";
				};

				/* Downstream doesn't have this one, but no reason not to include it */
				board-crit {
					/* shut down at 85C */
					temperature = <85000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map-board {
					trip = <&board_alert_trip>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};
};
